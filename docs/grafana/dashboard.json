				}
			],
			"title": "Fraudulent v. Total Orders (%)",
			"transformations": [
				{
					"id": "calculateField",
					"options": {
						"alias": "difference",
						"binary": {
							"left": {
								"matcher": {
									"id": "byName",
									"options": "{__name__=\"fraud_orders_total\", job=\"orchestrator\", service_name=\"orchestrator\"}"
								}
							},
							"operator": "/",
							"right": {
								"matcher": {
									"id": "byName",
									"options": "{__name__=\"orders_total\", endpoint=\"/checkout\", job=\"orchestrator\", service_name=\"orchestrator\"}"
								}
							}
						},
						"mode": "binary",
						"reduce": {
							"include": [],
							"reducer": "diffperc"
						},
						"replaceFields": false
					}
				},
				{
					"id": "calculateField",
					"options": {
						"alias": "diff100",
						"binary": {
							"left": {
								"matcher": {
									"id": "byName",
									"options": "difference"
								}
							},
							"operator": "*",
							"right": {
								"fixed": "100"
							}
						},
						"mode": "binary",
						"reduce": {
							"reducer": "sum"
						},
						"replaceFields": true
					}
				}
			],
			"type": "timeseries"
		},
